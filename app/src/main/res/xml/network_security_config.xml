<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for LocalAndroidStore.

  GitHub uses a rotating CDN and certificate chain. Trust Android's maintained
  system CA store instead of shipping a static pinset that can strand every
  catalog and release download when GitHub changes its chain. Cleartext remains
  forbidden for every destination.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
